# Everything works offline with no settings. Optional upgrades:

# Database: SQLite by default. Postgres + pgvector (docker compose up db, or a free Neon/Supabase instance):
# DATABASE_URL=postgresql+psycopg://claimcheck:claimcheck@localhost:5432/claimcheck

# LLM: any OpenAI-compatible endpoint. Free and local with Ollama (no data leaves the machine):
#   ollama pull qwen2.5:3b && ollama pull nomic-embed-text
# LLM_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=qwen2.5:3b
# AGENT_MODEL=qwen2.5:7b-instruct      # optional: a bigger model for tool calling (slow on 8 GB machines)
# EMBED_MODEL=nomic-embed-text

# Reference paid-API price (USD per 1M tokens) for the cost panel. Check your provider's current price list.
# REFERENCE_MODEL_NAME=paid API reference
# REFERENCE_PRICE_IN=0.15
# REFERENCE_PRICE_OUT=0.60

# Integrations
# CMS_BASE_URL=http://localhost:8001
# CMS_API_KEY=demo-cms-key
# WEBHOOK_URL=http://localhost:8001/webhooks/claimcheck
# WEBHOOK_SECRET=change-me
